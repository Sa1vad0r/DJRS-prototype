<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="680.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.djrs.controller.MainViewController">

   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-bar" BorderPane.alignment="CENTER">
         <Label styleClass="app-logo" text="DJRS Rewind" />

         <Region HBox.hgrow="ALWAYS" />

         <TextField prefWidth="200.0" promptText="Search" />
         <Circle fx:id="profileCircle" fill="#c0c5c9" onMouseClicked="#onOpenSettings" radius="12.0" stroke="TRANSPARENT" strokeType="INSIDE" styleClass="avatar" />
         <Button fx:id="signOutButton" onAction="#onSignOut" styleClass="button-ghost" text="Sign Out" />
      </HBox>
   </top>

   <center>
      <VBox spacing="24.0">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
         </padding>

         <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="4.0">
               <Label styleClass="title" text="Your Rewinds" />
               <Label styleClass="subtitle" text="Dive into your musical history and discover new trends in genre, artists, and favorite songs you might have forgotten." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="addRewindButton" mnemonicParsing="false" onAction="#onAddRewind" styleClass="button-accent" text="Create New Rewind" />
         </HBox>

         <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <FlowPane fx:id="rewindCards" hgap="16.0" vgap="16.0" />
         </ScrollPane>
      </VBox>
   </center>
</BorderPane>
