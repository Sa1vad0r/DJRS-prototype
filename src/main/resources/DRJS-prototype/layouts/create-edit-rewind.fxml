<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.djrs.controller.CreateEditController"
            prefWidth="1000" prefHeight="680">

    <top>
        <HBox styleClass="nav-bar">
            <Label text="DJRS rewind" styleClass="app-logo"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="10" styleClass="card" maxWidth="460">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <Label fx:id="pageTitleLabel" text="Create Rewind" styleClass="heading"/>
                <Label text="Rewind title"/>
                <TextField fx:id="titleField" promptText="e.g. Spring 2026"/>
                <HBox spacing="12">
                    <VBox spacing="4">
                        <Label text="Start date"/>
                        <DatePicker fx:id="startPicker"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="End date"/>
                        <DatePicker fx:id="endPicker"/>
                    </VBox>
                </HBox>
                <Label fx:id="errorLabel" text="" styleClass="text-danger"/>
            </VBox>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="tracksLabel" text="Tracks (0)" styleClass="heading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Manually Add Song" styleClass="button-accent" onAction="#onAddSong"/>
            </HBox>

            <TableView fx:id="tracksTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Song Title"/>
                    <TableColumn fx:id="artistColumn" text="Artist"/>
                    <TableColumn fx:id="albumColumn" text="Album"/>
                    <TableColumn fx:id="genreColumn" text="Genre"/>
                    <TableColumn fx:id="dateColumn" text="Date Listened"/>
                    <TableColumn fx:id="playsColumn" text="Play Count"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Cancel Changes" styleClass="button-ghost" onAction="#onCancel"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Save &amp; Generate Rewind" onAction="#onSave"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
