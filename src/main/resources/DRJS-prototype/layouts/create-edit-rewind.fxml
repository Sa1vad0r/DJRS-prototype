<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680" prefWidth="1000" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.djrs.controller.CreateEditController">

    <top>
        <HBox styleClass="nav-bar">
            <Label styleClass="app-logo" text="DJRS rewind" />
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets bottom="24" left="24" right="24" top="24" />
            </padding>

            <VBox maxWidth="1020.0" prefHeight="200.0" prefWidth="1020.0" spacing="10" styleClass="card">
                <padding>
                    <Insets bottom="16" left="16" right="16" top="16" />
                </padding>
                <Label fx:id="pageTitleLabel" styleClass="heading" text="Create Rewind" />
                <Label text="Rewind title" />
                <TextField fx:id="titleField" promptText="e.g. Spring 2026" />
                <HBox spacing="12">
                    <VBox spacing="4">
                        <Label text="Start date" />
                        <DatePicker fx:id="startPicker" />
                    </VBox>
                    <VBox spacing="4">
                        <Label text="End date" />
                        <DatePicker fx:id="endPicker" />
                    </VBox>
                </HBox>
                <Label fx:id="errorLabel" styleClass="text-danger" text="" />
            </VBox>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="tracksLabel" styleClass="heading" text="Tracks (0)" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onAddSong" styleClass="button-accent" text="Manually Add Song" />
            </HBox>

            <TableView fx:id="tracksTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Song Title" />
                    <TableColumn fx:id="artistColumn" text="Artist" />
                    <TableColumn fx:id="albumColumn" text="Album" />
                    <TableColumn fx:id="genreColumn" text="Genre" />
                    <TableColumn fx:id="dateColumn" text="Date Listened" />
                    <TableColumn fx:id="playsColumn" text="Play Count" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button onAction="#onCancel" styleClass="button-ghost" text="Cancel Changes" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onSave" text="Save &amp; Generate Rewind" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
