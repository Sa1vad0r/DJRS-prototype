<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Styling comes from /DRJS-prototype/style/theme.css (added to the Scene in MainApplication) -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.djrs.controller.MainViewController"
            prefWidth="1000" prefHeight="680">

    <top>
        <HBox styleClass="nav-bar">
            <Label text="DJRS rewind" styleClass="app-logo"/>
            <Button text="Home" styleClass="nav-link"/>
            <Button text="Rewinds" styleClass="nav-link"/>
            <Button text="Settings" styleClass="nav-link"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="signOutButton" text="Sign out" styleClass="button-ghost" onAction="#onSignOut"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Your Rewinds" styleClass="title"/>
                    <Label text="Pick a rewind to view, or create a new one." styleClass="subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addRewindButton" text="+ Add Rewind" styleClass="button-accent"
                        onAction="#onAddRewind"/>
            </HBox>

            <TableView fx:id="rewindTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name"/>
                    <TableColumn fx:id="rangeColumn" text="Date range"/>
                    <TableColumn fx:id="songsColumn" text="Songs"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="viewButton" text="View" onAction="#onView"/>
                <Button fx:id="deleteButton" text="Delete" styleClass="button-danger" onAction="#onDelete"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
