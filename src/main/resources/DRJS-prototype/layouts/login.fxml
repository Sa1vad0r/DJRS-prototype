<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.qlh240_lab4.LoginScreenController">
   <children>
      <VBox alignment="CENTER" prefHeight="383.0" prefWidth="586.0" spacing="15.0" StackPane.alignment="CENTER">
         <children>
            <TextField fx:id="usernameField" prefWidth="556.0" />
            <PasswordField fx:id="passwordField" />
            <Button mnemonicParsing="false" onAction="#handleLogin" text="Log In">
               <font>
                  <Font size="10.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
