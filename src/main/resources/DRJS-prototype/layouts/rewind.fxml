<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<!-- Styling comes from /DRJS-prototype/style/theme.css (added to the Scene in MainApplication).
     This ONE file holds all 4 slides. ViewRewindController shows one slide at a time. -->

<BorderPane fx:id="root" prefHeight="680.0" prefWidth="1000.0" styleClass="rewind-slide" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.djrs.controller.ViewRewindController">

    <!-- ===================== TOP: progress segments + logo/title/close ===================== -->
    <top>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="0.0" left="20.0" right="20.0" top="14.0" />
            </padding><!-- 4 thin bars, one per slide. The controller marks the active ones. -->
            <HBox fx:id="segmentBar" spacing="6.0">
                <Region styleClass="segment" HBox.hgrow="ALWAYS" />
                <Region styleClass="segment" HBox.hgrow="ALWAYS" />
                <Region styleClass="segment" HBox.hgrow="ALWAYS" />
                <Region styleClass="segment" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <Label styleClass="app-logo" text="DJRS rewind" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="rewindNameLabel" styleClass="label-muted" text="Vocaloid Summer 2026" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onClose" styleClass="button-close" text="✕" />
            </HBox>

        </VBox>
    </top>

    <!-- ===================== CENTER: glow blobs behind, 4 slides on top ===================== -->
    <center>
        <StackPane mouseTransparent="true"><!-- Layer 1: blurry colored blobs. mouseTransparent so clicks pass through. -->
            <Pane>
                <Circle layoutX="200.0" layoutY="120.0" radius="90.0" styleClass="glow-yellow">
                    <effect>
                        <GaussianBlur radius="63.0" />
                    </effect>
                </Circle>
                <Circle layoutX="700.0" layoutY="380.0" radius="90.0" styleClass="glow-green">
                    <effect>
                        <GaussianBlur radius="63.0" />
                    </effect>
                </Circle>
                <Circle layoutX="560.0" layoutY="100.0" radius="80.0" styleClass="glow-purple">
                    <effect>
                        <GaussianBlur radius="63.0" />
                    </effect>
                </Circle>
                <Circle layoutX="420.0" layoutY="420.0" radius="80.0" styleClass="glow-red">
                    <effect>
                        <GaussianBlur radius="63.0" />
                    </effect>
                </Circle>
            </Pane>

            <!-- Layer 2: the slides. Only one is visible at a time (controller does this).
                 Keep slideStack holding ONLY slides, because the controller loops over its children. -->
            <StackPane fx:id="slideStack"><!-- ============ SLIDE 1: total songs ============ -->
                <VBox fx:id="slide1" alignment="CENTER" spacing="6.0">
                    <Label styleClass="slide-title" text="You listened to..." />
                    <Label fx:id="songCountLabel" styleClass="slide-stat" text="727 songs" />
                </VBox>

                <!-- ============ SLIDE 2: most listened to song ============ -->
                <HBox fx:id="slide2" alignment="CENTER" spacing="70.0">
                    <Label maxWidth="360.0" prefWidth="360.0" styleClass="slide-title" text="Your Most Listened to Song was..." wrapText="true" />
                    <VBox alignment="CENTER" spacing="8.0">
                        <!-- Placeholder for album art. Swap for an ImageView later. -->
                        <Rectangle fx:id="songRectangle" arcHeight="16.0" arcWidth="16.0" fill="#c0c5c9" height="210.0" styleClass="album-art" width="190.0" />
                        <Label fx:id="topSongLabel" styleClass="slide-caption-bold text-accent" text="“Spoken For”" />
                        <Label fx:id="topSongArtistLabel" styleClass="slide-caption-bold text-accent" text="FLAVOR FOLEY" />
                        <HBox alignment="CENTER" spacing="5.0">
                            <padding>
                                <Insets top="10.0" />
                            </padding>
                            <Label styleClass="slide-caption-bold" text="Played" />
                            <Label fx:id="playCountLabel" styleClass="slide-caption-bold text-accent" text="33" />
                            <Label styleClass="slide-caption-bold" text="times this month!" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- ============ SLIDE 3: favorite artist ============ -->
                <HBox fx:id="slide3" alignment="CENTER" spacing="90.0">
                    <VBox alignment="CENTER" spacing="10.0">
                        <!-- Placeholder for the artist photo. Swap for an ImageView with a circle clip later. -->
                        <Circle fx:id="artistCircle" fill="#c0c5c9" radius="62.0" styleClass="avatar" />
                        <Label fx:id="artistNameLabel" styleClass="slide-caption-bold text-accent" text="“Jamie Paige”" />
                        <HBox alignment="CENTER" spacing="5.0">
                            <padding>
                                <Insets top="8.0" />
                            </padding>
                            <Label styleClass="slide-caption-bold" text="Genre:" />
                            <Label fx:id="artistGenreLabel" styleClass="slide-caption-bold text-accent" text="Vocaloid" />
                        </HBox>
                    </VBox>
                    <Label maxWidth="340.0" prefWidth="340.0" styleClass="slide-title" text="Your Favorite Artist was..." wrapText="true" />
                </HBox>

                <!-- ============ SLIDE 4: top genre ============ -->
                <HBox fx:id="slide4" alignment="CENTER" spacing="50.0"><!-- Donut = pie chart with a dark circle on top to punch the hole -->
                    <StackPane>
                        <PieChart fx:id="genreChart" animated="false" labelsVisible="false" legendVisible="false" maxHeight="260.0" maxWidth="260.0" minHeight="260.0" minWidth="260.0" prefHeight="260.0" prefWidth="260.0" startAngle="90.0">
                            <!-- Slices are added in RewindController.initialize() -->
                        </PieChart>
                        <Circle fill="#0a0a0c" mouseTransparent="true" radius="62.0" />
                        <VBox alignment="CENTER" maxHeight="100.0" maxWidth="100.0" mouseTransparent="true">
                            <Label styleClass="heading" text="3" />
                            <Label styleClass="card-meta" text="TOP GENRES" />
                        </VBox>
                    </StackPane>

                    <!-- Legend -->
                    <VBox alignment="CENTER_LEFT" maxWidth="170.0" prefWidth="170.0" spacing="8.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Circle fill="#76b87a" radius="4.0" />
                            <Label styleClass="card-meta" text="Vocaloid" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="card-meta" text="80%" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Circle fill="#4b8bf5" radius="4.0" />
                            <Label styleClass="card-meta" text="Hip-Hop" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="card-meta" text="15%" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Circle fill="#55555f" radius="4.0" />
                            <Label styleClass="card-meta" text="Other" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="card-meta" text="5%" />
                        </HBox>
                    </VBox>

                    <VBox alignment="CENTER" spacing="6.0">
                        <children>
                            <Label maxWidth="300.0" prefWidth="300.0" styleClass="slide-title" text="Your Top Genre Was..." wrapText="true" />
                            <Label fx:id="topGenreLabel" styleClass="slide-stat" text="Vocaloid" />
                        </children>
                    </VBox>

                </HBox>

            </StackPane>

        </StackPane>
    </center>

    <!-- ===================== BOTTOM: Previous / Next (never changes) ===================== -->
    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="10.0" />
            </padding>
            <Button fx:id="prevButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#onPrevious" styleClass="button-ghost" text="←  Previous" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="nextButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#onNext" styleClass="button-ghost" text="Next  →" />
        </HBox>
    </bottom>
</BorderPane>
