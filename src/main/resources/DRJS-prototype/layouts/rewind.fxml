<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<!-- Styling comes from /DRJS-prototype/style/theme.css (added to the Scene in MainApplication).
     This ONE file holds all 4 slides. ViewRewindController shows one slide at a time. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.djrs.controller.ViewRewindController"
            styleClass="rewind-slide"
            prefWidth="1000.0" prefHeight="680.0">

    <!-- ===================== TOP: progress segments + logo/title/close ===================== -->
    <top>
        <VBox spacing="14.0">
            <padding>
                <Insets top="14.0" right="20.0" bottom="0.0" left="20.0"/>
            </padding>
            <children>

                <!-- 4 thin bars, one per slide. The controller marks the active ones. -->
                <HBox fx:id="segmentBar" spacing="6.0">
                    <children>
                        <Region styleClass="segment" HBox.hgrow="ALWAYS"/>
                        <Region styleClass="segment" HBox.hgrow="ALWAYS"/>
                        <Region styleClass="segment" HBox.hgrow="ALWAYS"/>
                        <Region styleClass="segment" HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="DJRS rewind" styleClass="app-logo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="rewindNameLabel" text="Vocaloid July 2026" styleClass="label-muted"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="closeButton" mnemonicParsing="false" text="✕" styleClass="button button-close"
                                onAction="#onClose"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </top>

    <!-- ===================== CENTER: glow blobs behind, 4 slides on top ===================== -->
    <center>
        <StackPane>
            <children>

                <!-- Layer 1: blurry colored blobs. mouseTransparent so clicks pass through. -->
                <Pane mouseTransparent="true">
                    <children>
                        <Circle radius="90.0" layoutX="200.0" layoutY="120.0" styleClass="glow-yellow">
                            <effect><GaussianBlur radius="63.0"/></effect>
                        </Circle>
                        <Circle radius="90.0" layoutX="700.0" layoutY="380.0" styleClass="glow-green">
                            <effect><GaussianBlur radius="63.0"/></effect>
                        </Circle>
                        <Circle radius="80.0" layoutX="560.0" layoutY="100.0" styleClass="glow-purple">
                            <effect><GaussianBlur radius="63.0"/></effect>
                        </Circle>
                        <Circle radius="80.0" layoutX="420.0" layoutY="420.0" styleClass="glow-red">
                            <effect><GaussianBlur radius="63.0"/></effect>
                        </Circle>
                    </children>
                </Pane>

                <!-- Layer 2: the slides. Only one is visible at a time (controller does this).
                     Keep slideStack holding ONLY slides, because the controller loops over its children. -->
                <StackPane fx:id="slideStack">
                    <children>

                        <!-- ============ SLIDE 1: total songs ============ -->
                        <VBox fx:id="slide1" alignment="CENTER" spacing="6.0">
                            <children>
                                <Label text="You listened to..." styleClass="slide-title"/>
                                <Label fx:id="songCountLabel" text="727 songs" styleClass="slide-stat"/>
                            </children>
                        </VBox>

                        <!-- ============ SLIDE 2: most listened to song ============ -->
                        <HBox fx:id="slide2" alignment="CENTER" spacing="70.0">
                            <children>
                                <Label text="Your Most Listened to Song was..." styleClass="slide-title"
                                       wrapText="true" prefWidth="360.0" maxWidth="360.0"/>
                                <VBox alignment="CENTER" spacing="8.0">
                                    <children>
                                        <!-- Placeholder for album art. Swap for an ImageView later. -->
                                        <Rectangle width="190.0" height="190.0" arcWidth="16.0" arcHeight="16.0"
                                                   fill="#c0c5c9" styleClass="album-art"/>
                                        <Label fx:id="topSongLabel" text="“Spoken For”" styleClass="slide-caption-bold text-accent"/>
                                        <Label fx:id="topSongArtistLabel" text="FLAVOR FOLEY" styleClass="slide-caption-bold text-accent"/>
                                        <HBox alignment="CENTER" spacing="5.0">
                                            <padding>
                                                <Insets top="10.0"/>
                                            </padding>
                                            <children>
                                                <Label text="Played" styleClass="slide-caption-bold"/>
                                                <Label fx:id="playCountLabel" text="33" styleClass="slide-caption-bold text-accent"/>
                                                <Label text="times this month!" styleClass="slide-caption-bold"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- ============ SLIDE 3: favorite artist ============ -->
                        <HBox fx:id="slide3" alignment="CENTER" spacing="90.0">
                            <children>
                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <!-- Placeholder for the artist photo. Swap for an ImageView with a circle clip later. -->
                                        <Circle radius="62.0" fill="#c0c5c9" styleClass="avatar"/>
                                        <Label fx:id="artistNameLabel" text="“Jamie Paige”" styleClass="slide-caption-bold text-accent"/>
                                        <HBox alignment="CENTER" spacing="5.0">
                                            <padding>
                                                <Insets top="8.0"/>
                                            </padding>
                                            <children>
                                                <Label text="Genre:" styleClass="slide-caption-bold"/>
                                                <Label fx:id="artistGenreLabel" text="Vocaloid" styleClass="slide-caption-bold text-accent"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <Label text="Your Favorite Artist was..." styleClass="slide-title"
                                       wrapText="true" prefWidth="340.0" maxWidth="340.0"/>
                            </children>
                        </HBox>

                        <!-- ============ SLIDE 4: top genre ============ -->
                        <HBox fx:id="slide4" alignment="CENTER" spacing="50.0">
                            <children>

                                <!-- Donut = pie chart with a dark circle on top to punch the hole -->
                                <StackPane>
                                    <children>
                                        <PieChart fx:id="genreChart" legendVisible="false" labelsVisible="false"
                                                  startAngle="90.0" animated="false"
                                                  minWidth="260.0" minHeight="260.0"
                                                  prefWidth="260.0" prefHeight="260.0"
                                                  maxWidth="260.0" maxHeight="260.0">
                                            <!-- Slices are added in RewindController.initialize() -->
                                        </PieChart>
                                        <Circle radius="62.0" fill="#0a0a0c" mouseTransparent="true"/>
                                        <VBox alignment="CENTER" mouseTransparent="true" maxWidth="100.0" maxHeight="100.0">
                                            <children>
                                                <Label text="3" styleClass="heading"/>
                                                <Label text="TOP GENRES" styleClass="card-meta"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>

                                <!-- Legend -->
                                <VBox spacing="8.0" alignment="CENTER_LEFT" prefWidth="170.0" maxWidth="170.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Circle radius="4.0" fill="#76b87a"/>
                                                <Label text="Vocaloid" styleClass="card-meta"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="80%" styleClass="card-meta"/>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Circle radius="4.0" fill="#4b8bf5"/>
                                                <Label text="Hip-Hop" styleClass="card-meta"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="15%" styleClass="card-meta"/>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Circle radius="4.0" fill="#55555f"/>
                                                <Label text="Other" styleClass="card-meta"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="5%" styleClass="card-meta"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox alignment="CENTER" spacing="6.0">
                                    <children>
                                        <Label text="Your Top Genre Was..." styleClass="slide-title"
                                               wrapText="true" prefWidth="300.0" maxWidth="300.0"/>
                                        <Label fx:id="topGenreLabel" text="Vocaloid" styleClass="slide-stat"/>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </children>
                </StackPane>

            </children>
        </StackPane>
    </center>

    <!-- ===================== BOTTOM: Previous / Next (never changes) ===================== -->
    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>
            <children>
                <Button fx:id="prevButton" mnemonicParsing="false" minWidth="-Infinity" text="←  Previous"
                        styleClass="button button-pill" onAction="#onPrevious"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="nextButton" mnemonicParsing="false" minWidth="-Infinity" text="Next  →"
                        styleClass="button button-pill" onAction="#onNext"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
